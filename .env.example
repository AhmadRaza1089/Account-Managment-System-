# Copy this file to .env and edit as needed. Everything here is optional:
# with no .env at all the project uses a local SQLite file and just works.

# --- SQLite (default) -------------------------------------------------
# Nothing to install or configure. Good for trying it out and for single
# users. This is what you get if DATABASE_URL is unset.
# DATABASE_URL=sqlite:///account_manager.db

# --- MySQL / MariaDB --------------------------------------------------
# Needs: pip install "account-manager[mysql]"
# DATABASE_URL=mysql+mysqlconnector://user:password@localhost:3306/account

# --- PostgreSQL -------------------------------------------------------
# Needs: pip install "account-manager[postgres]"
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/account

# Log every SQL statement (noisy; useful when debugging).
# ECHO_SQL=false

# --- AI features (all optional) ---------------------------------------
# Leave AI_PROVIDER unset and everything still works, including
# `account-manager ai check`, which needs no provider at all.
#
# Claude — needs: pip install "account-manager[claude]"
# AI_PROVIDER=claude
# ANTHROPIC_API_KEY=sk-ant-...
#
# OpenAI — needs: pip install "account-manager[openai]"
# AI_PROVIDER=openai
# OPENAI_API_KEY=sk-...
#
# Ollama — free, local, offline; nothing to install but Ollama itself,
# and your financial data never leaves your machine.
# AI_PROVIDER=ollama
# OLLAMA_HOST=http://localhost:11434
#
# Override the default model for whichever provider you chose.
# AI_MODEL=
